+#include <stdlib.h>
+#include <sys/sysinfo.h>
+int getloadavg(double averages[], int n) {
+        if (n < 0) return -1;
+        if (n > 3) n = 3;
+        struct sysinfo si;
+        if (sysinfo(&si) == -1) return -1;
+        for (int i = 0; i < n; ++i) {
+                averages[i] = 1.0 * si.loads[i] / (1 << SI_LOAD_SHIFT);
+        }
+        return n;
+}
